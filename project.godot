; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="GunFare"
config/description="Arcade multiplayer FPS with rank, unlock and Ascension progression."
config/version="0.1.0"
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Settings="*res://scripts/autoload/settings.gd"
GameEvents="*res://scripts/autoload/game_events.gd"
ContentDB="*res://scripts/autoload/content_db.gd"
Progression="*res://scripts/autoload/progression.gd"
ChallengeTracker="*res://scripts/autoload/challenge_tracker.gd"
Sfx="*res://scripts/autoload/sfx.gd"
Fx="*res://scripts/autoload/fx.gd"
Game="*res://scripts/autoload/game.gd"
UpdateService="*res://scripts/autoload/update_service.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[navigation]

3d/default_cell_size=0.25
3d/default_cell_height=0.1

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=12
common/physics_interpolation=true

[rendering]

anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
textures/default_filters/anisotropic_filtering_level=4
environment/ssao/quality=3
anti_aliasing/quality/use_debanding=true
